# MongoDB Atlas connection string. Replace <db_password> and the database name.
MONGODB_URI=<>

# Use a random secret with at least 32 characters. Never share or commit this value.
JWT_SECRET=replace-this-with-a-long-random-secret-of-at-least-32-characters
PORT=5000

# First administrator account created automatically when the backend starts.
ADMIN_NAME=SmartPark Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Frontend origin(s), comma-separated. Local Vite origin is allowed automatically.
FRONTEND_URL=http://localhost:5173
